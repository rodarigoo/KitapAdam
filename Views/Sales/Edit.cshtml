@model KirtasiyeProjesi.Models.Sale

@{
    ViewData["Title"] = "Satışı Düzenle";
}

<div class="container mt-5">
    <h1><i class="bi bi-pencil-square text-warning"></i> Satışı Düzenle</h1>
    <hr />
    <div class="card shadow-sm border-0 bg-light">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="form-group mb-3">
                            <label asp-for="Date" class="control-label fw-bold">Satış Tarihi</label>
                            <input asp-for="Date" class="form-control" />
                            <span asp-validation-for="Date" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="ProductId" class="control-label fw-bold">Ürün</label>
                            <select asp-for="ProductId" class="form-control" asp-items="ViewBag.ProductId"></select>
                            <span asp-validation-for="ProductId" class="text-danger"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="Quantity" class="control-label fw-bold">Adet</label>
                            <input asp-for="Quantity" class="form-control" />
                            <span asp-validation-for="Quantity" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <button type="submit" class="btn btn-warning shadow-sm">
                                <i class="bi bi-save"></i> Güncelle
                            </button>
                            <a asp-action="Index" class="btn btn-secondary shadow-sm">
                                <i class="bi bi-arrow-left"></i> İptal
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>