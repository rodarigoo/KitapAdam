@model KirtasiyeProjesi.Models.Category

@{
    ViewData["Title"] = "Kategori Detayı";
}

<div class="container mt-5">
    <h1>Kategori Detayı</h1>
    <hr />
    <dl class="row">
        <dt class="col-sm-2 fw-bold">
            Kategori Adı:
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Name)
        </dd>
    </dl>
    <div class="mt-3">
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="btn btn-warning">Düzenle</a>
        <a asp-action="Index" class="btn btn-secondary">Listeye Dön</a>
    </div>
</div>