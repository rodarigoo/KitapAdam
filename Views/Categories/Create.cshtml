@model KirtasiyeProjesi.Models.Category

@{
    ViewData["Title"] = "Yeni Kategori";
}

<div class="container mt-5">
    <h1>Yeni Kategori Ekle</h1>
    <hr />
    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="form-group mb-3">
                    <label asp-for="Name" class="control-label fw-bold">Kategori Adı</label>
                    <input asp-for="Name" class="form-control" placeholder="Örn: Defterler" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <input type="submit" value="Oluştur" class="btn btn-success" />
                    <a asp-action="Index" class="btn btn-secondary">Listeye Dön</a>
                </div>
            </form>
        </div>
    </div>
</div>